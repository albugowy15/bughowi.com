---
import { Image } from "astro:assets";
import profile_pic from "@/assets/profile.png";
import Link from "@/components/Link.astro";
import { SOCIAL_MEDIA, SOCIAL_MEDIA_LINKS } from "@/lib/constant";
---

<footer
  class="not-prose container mx-auto px-3 pb-[calc(7rem+env(safe-area-inset-bottom))] md:pb-6 xl:px-14 2xl:max-w-7xl"
>
  <div
    class="flex flex-col gap-6 rounded-md border p-5 lg:flex-row lg:items-end lg:justify-between"
  >
    <div class="flex flex-col gap-3">
      <Image
        src={profile_pic}
        width={60}
        height={60}
        class="aspect-square hidden lg:block"
        alt="Mohamad Kholid Bughowi"
      />
      <div class="lg:mt-4 text-sm lg:text-base flex flex-col gap-1">
        <p class="font-bold">Mohamad Kholid Bughowi - Personal Blog</p>
        <p class="text-foreground/60">
          Blog content managed using Astro content collection
        </p>
      </div>
      <p class="text-foreground/60 text-sm lg:text-base">
        Made with ❤ By <Link
          variant="underline"
          class={"cursor-pointer text-foreground lg:mx-1 text-sm lg:text-base"}
          href={SOCIAL_MEDIA.github.href}>Mohamad Kholid Bughowi</Link
        > using <Link
          variant="underline"
          class={"cursor-pointer text-foreground lg:mx-1 text-sm lg:text-base"}
          href="https://astro.build">Astro</Link
        >
      </p>
    </div>
    <div class="hidden lg:flex flex-col justify-between gap-5">
      <div class="border p-4 rounded-lg">
        <ul class="flex gap-2 items-center justify-between text-foreground/60">
          <li><Link href="/blog/page/1" external={false}>Blog</Link></li>
          <li>
            <Link href="/projects/page/1" external={false}>Projects</Link>
          </li>
          <li>
            <Link href="/snippets/page/1" external={false}>Snippets</Link>
          </li>
          <li>
            <Link href="/about" external={false}>About</Link>
          </li>
        </ul>
        <ul class="flex items-center gap-4 justify-end mt-4">
          {
            SOCIAL_MEDIA_LINKS.map((social) => (
              <li>
                <a
                  href={social.href}
                  rel="noreferrer"
                  target="_blank"
                  title={social.label}
                  aria-label={`${social.label}: ${social.username}`}
                  class="flex items-center gap-1 rounded-sm font-bold transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class={`social-icon social-icon-${social.id}`}
                    viewBox="0 0 24 24"
                  >
                    <path d={social.iconPath} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="text-foreground/60">&copy; 2026 Mohamad Kholid Bughowi</p>
    </div>
  </div>
</footer>
