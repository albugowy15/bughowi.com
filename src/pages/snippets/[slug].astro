---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContentDetailHeader from "@/components/ContentDetailHeader.astro";
import type { ContentNavigator } from "@/components/pagination/ContentPagination.astro";
import ContentPagination from "@/components/pagination/ContentPagination.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import { compareDesc } from "@/utils/date";

interface Props {
  post: CollectionEntry<"snippets">;
  nextPost: ContentNavigator | null;
  prevPost: ContentNavigator | null;
}

export const getStaticPaths = (async () => {
  const snippetCollection = await getCollection("snippets");
  const sortedSnippetCollection = snippetCollection.sort((a, b) =>
    compareDesc(a.data.date, b.data.date),
  );
  const totalSnippet = sortedSnippetCollection.length;
  return sortedSnippetCollection.flatMap((post, idx) => ({
    params: {
      slug: post.id,
    },
    props: {
      nextPost:
        idx !== totalSnippet - 1
          ? {
              title: sortedSnippetCollection[idx + 1]?.data.title,
              slug: `/snippets/${sortedSnippetCollection[idx + 1]?.id}`,
            }
          : null,
      prevPost:
        idx !== 0
          ? {
              title: sortedSnippetCollection[idx - 1]?.data.title,
              slug: `/snippets/${sortedSnippetCollection[idx - 1]?.id}`,
            }
          : null,
      post,
    },
  }));
}) satisfies GetStaticPaths;

const { post, nextPost, prevPost } = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await render(post);
const snippetUrl = new URL(`/snippets/${post.id}`, Astro.site);
---

<Layout
  title={post.data.title}
  type="article"
  description={post.data.description}
  url={snippetUrl.href}
>
  <div
    class:list={[
      "mx-auto grid w-full gap-10 lg:items-start",
      headings.length > 0 ? "lg:grid-cols-[minmax(0,1fr)_18rem]" : "max-w-4xl",
    ]}
  >
    <div class="min-w-0">
      <div class="space-y-4">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Snippets", href: "/snippets/page/1" },
            { label: post.data.title },
          ]}
        />
        <ContentDetailHeader
          heading={post.data.title}
          description={post.data.description}
          publishedAt={post.data.date}
          readingTime={String(remarkPluginFrontmatter.minutesRead)}
          tags={post.data.categories}
          tagsLabel="Topics"
          tagsAriaLabel="Snippet topics"
        />
      </div>
      <TableOfContents headings={headings} variant="mobile" class="mt-5" />
      <article
        class:list={["w-full", headings.length > 0 ? "lg:mt-8" : "mt-8"]}
      >
        <section
          id="content-space"
          class="prose prose-invert max-w-none prose-headings:scroll-mt-24 md:prose-headings:scroll-mt-40 lg:prose-headings:scroll-mt-48"
        >
          <Content />
        </section>
      </article>
      <ContentPagination next={nextPost} prev={prevPost} />
      <section class="mt-12">
        <!-- Giscus comment -->
        <script
          is:inline
          data-loading="lazy"
          src="https://giscus.app/client.js"
          data-repo="albugowy15/bughowi.com"
          data-repo-id="R_kgDOHqneBQ"
          data-category="Announcements"
          data-category-id="DIC_kwDOHqneBc4CQdnP"
          data-mapping="url"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="dark"
          data-lang="en"
          crossorigin="anonymous"
          async></script>
      </section>
    </div>
    <TableOfContents headings={headings} variant="desktop" />
  </div>
</Layout>
