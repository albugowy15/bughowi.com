---
import { getCollection } from "astro:content";
import PostCard from "@/components/card/PostCard.astro";
import ProjectCard from "@/components/card/ProjectCard.astro";
import SnippetCard from "@/components/card/SnippetCard.astro";
import Layout from "@/layouts/Layout.astro";
import { compareDesc } from "@/utils/date";
import { CV_DOCUMENT_URL } from "@/lib/constant";
import { buttonVariants } from "@/components/Button";

const [blogCollections, projectCollections, snippetCollections] =
  await Promise.all([
    getCollection("blog"),
    getCollection("projects"),
    getCollection("snippets"),
  ]);

const someBlogPosts = blogCollections
  .sort((a, b) => compareDesc(a.data.date, b.data.date))
  .slice(0, 6);
const someProjectPosts = projectCollections
  .sort((a, b) => compareDesc(a.data.date, b.data.date))
  .slice(0, 6);
const someSnippetPosts = snippetCollections
  .sort((a, b) => compareDesc(a.data.date, b.data.date))
  .slice(0, 6);
---

<Layout
  title="Home"
  description="Software architect and engineer with a passion for building comprehensive solutions. From initial concept to production deployment, I create robust systems that drive business value and user satisfaction."
>
  <section
    class="mx-auto flex min-h-[calc(100svh-10rem)] max-w-5xl flex-col items-center justify-center py-16 text-center sm:py-20"
  >
    <h1
      class="max-w-5xl text-balance text-5xl leading-[0.92] font-bold tracking-tight sm:text-6xl lg:text-7xl"
    >
      Mohamad Kholid Bughowi
    </h1>
    <h2 class="mt-5 text-lg font-semibold tracking-wide sm:text-xl lg:text-2xl">
      Software Engineer
    </h2>
    <p
      class="mt-5 max-w-2xl text-pretty text-base text-foreground/80 lg:text-xl"
    >
      Software architect and engineer with a passion for building comprehensive
      solutions. From initial concept to production deployment, I create robust
      systems that drive business value and user satisfaction.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      <a
        class:list={[
          buttonVariants({ variant: "default", size: "lg" }),
          "!font-bold",
        ]}
        href="/about">More About Me</a
      >
      <a
        class:list={[
          buttonVariants({ variant: "outline", size: "lg" }),
          "!font-bold",
        ]}
        aria-label="Resume"
        href={CV_DOCUMENT_URL}
        rel="noreferrer"
        target="_blank"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="h-5 w-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"
          ></path>
        </svg>
        Resume
      </a>
    </div>
  </section>
  <div class="space-y-14 sm:space-y-18 lg:space-y-20">
    <section id="recent-posts" class="scroll-mt-28 pt-7 sm:pt-8">
      <h2>
        <a
          href="/blog/page/1"
          class="inline-flex text-3xl font-bold text-pretty transition-colors hover:cursor-pointer hover:text-primary sm:text-4xl"
        >
          Recent Posts
        </a>
      </h2>
      <div class="mt-5 grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {someBlogPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
    <section id="personal-projects" class="scroll-mt-28 pt-7 sm:pt-8">
      <h2>
        <a
          href="/projects/page/1"
          class="inline-flex text-3xl font-bold text-pretty transition-colors hover:cursor-pointer hover:text-primary sm:text-4xl"
        >
          Personal Projects
        </a>
      </h2>
      <div class="mt-5 grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {someProjectPosts.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
    <section id="snippets" class="scroll-mt-28 pt-7 sm:pt-8">
      <h2>
        <a
          href="/snippets/page/1"
          class="inline-flex text-3xl font-bold text-pretty transition-colors hover:cursor-pointer hover:text-primary sm:text-4xl"
        >
          Snippets
        </a>
      </h2>
      <div class="mt-5 grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {someSnippetPosts.map((snippet) => <SnippetCard snippet={snippet} />)}
      </div>
    </section>
  </div>
</Layout>
