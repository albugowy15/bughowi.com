---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContentDetailHeader from "@/components/ContentDetailHeader.astro";
import ContentPagination, {
  type ContentNavigator,
} from "@/components/pagination/ContentPagination.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import { compareDesc } from "@/utils/date";

interface Props {
  post: CollectionEntry<"projects">;
  nextPost: ContentNavigator | null;
  prevPost: ContentNavigator | null;
}

export const getStaticPaths = (async () => {
  const projectCollection = await getCollection("projects");
  const sortedProjectCollection = projectCollection.sort((a, b) =>
    compareDesc(a.data.date, b.data.date),
  );
  const totalPost = sortedProjectCollection.length;
  return sortedProjectCollection.flatMap((post, idx) => ({
    params: {
      slug: post.id,
    },
    props: {
      nextPost:
        idx !== totalPost - 1
          ? {
              title: sortedProjectCollection[idx + 1]?.data.title,
              slug: `/projects/${sortedProjectCollection[idx + 1]?.id}`,
            }
          : null,
      prevPost:
        idx !== 0
          ? {
              title: sortedProjectCollection[idx - 1]?.data.title,
              slug: `/projects/${sortedProjectCollection[idx - 1]?.id}`,
            }
          : null,
      post,
    },
  }));
}) satisfies GetStaticPaths;

const { post, nextPost, prevPost } = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await render(post);
const url = new URL(`/projects/${post.id}`, Astro.site);
---

<Layout
  title={post.data.title}
  type="article"
  img={post.data.thumbnail}
  description={post.data.description}
  url={url.href}
>
  <div
    class:list={[
      "mx-auto grid w-full gap-10 xl:items-start",
      headings.length > 0 ? "xl:grid-cols-[minmax(0,1fr)_18rem]" : "max-w-4xl",
    ]}
  >
    <div class="min-w-0">
      <div class="space-y-4">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            { label: "Projects", href: "/projects/page/1" },
            { label: post.data.title },
          ]}
        />
        <ContentDetailHeader
          heading={post.data.title}
          description={post.data.description}
          publishedAt={post.data.date}
          readingTime={String(remarkPluginFrontmatter.minutesRead)}
          tags={post.data.tech}
          tagsLabel="Technologies"
          tagsAriaLabel="Project technologies"
        />
      </div>
      <TableOfContents headings={headings} variant="mobile" class="mt-5" />
      <article
        class:list={[
          "w-full space-y-8",
          headings.length > 0 ? "xl:mt-8" : "mt-8",
        ]}
      >
        {
          post.data.thumbnail && (
            <Image
              src={post.data.thumbnail}
              alt={post.data.title}
              width={1280}
              height={720}
              loading="eager"
              priority
              class="rounded-lg object-contain"
            />
          )
        }
        <section
          id="content-space"
          class="prose prose-invert max-w-none prose-headings:scroll-mt-24 md:prose-headings:scroll-mt-40 lg:prose-headings:scroll-mt-48 xl:prose-headings:scroll-mt-28"
        >
          <Content />
        </section>
      </article>
      <ContentPagination next={nextPost} prev={prevPost} />
      <section class="mt-12">
        <!-- Giscus comment -->
        <script
          is:inline
          data-loading="lazy"
          src="https://giscus.app/client.js"
          data-repo="albugowy15/bughowi.com"
          data-repo-id="R_kgDOHqneBQ"
          data-category="Announcements"
          data-category-id="DIC_kwDOHqneBc4CQdnP"
          data-mapping="url"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="dark"
          data-lang="en"
          crossorigin="anonymous"
          async></script>
      </section>
    </div>
    <TableOfContents headings={headings} variant="desktop" />
  </div>
</Layout>
